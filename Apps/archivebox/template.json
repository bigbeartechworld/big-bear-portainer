        {"name": "PUBLIC_INDEX", "label": "PUBLIC_INDEX", "description": "Container Variable: PUBLIC_INDEX", "default": "true"},
        {"name": "PUBLIC_SNAPSHOTS", "label": "PUBLIC_SNAPSHOTS", "description": "Container Variable: PUBLIC_SNAPSHOTS", "default": "true"},
