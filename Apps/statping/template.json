        "stackfile": "Apps/statping/docker-compose.yml"
      },
      "env": [
        {"name": "VIRTUAL_PORT", "label": "VIRTUAL_PORT", "description": "Container Variable: VIRTUAL_PORT", "default": "8080"},
        {"name": "DB_CONN", "label": "DB_CONN", "description": "Container Variable: DB_CONN", "default": "postgres"},
        {"name": "DB_HOST", "label": "DB_HOST", "description": "Container Variable: DB_HOST", "default": "db"},
