        {"name": "TZ", "label": "TZ", "description": "specify a timezone to use, see this list.", "default": "$TZ"},
        {"name": "POSTGRES_USER", "label": "POSTGRES_USER", "description": "Postgres server username", "default": "bigbear"},
        {"name": "POSTGRES_PASSWORD", "label": "POSTGRES_PASSWORD", "description": "Postgres server password", "default": "dc640cd4-0450-4a94-aedb-ee5b43b32a45"},
